# Optional Hugging Face token (if the checkpoint is gated).
RFD4_HF_TOKEN=

# Optional checkpoint revision to pin for reproducibility.
# RFD4_HF_REVISION=<commit>

# Load the model at startup instead of on the first request.
# RFD4_PRELOAD_MODEL=rfd4-proteina

# Base directory for per-run design outputs.
RFD4_RUNS_ROOT=./runs

RFD4_HOST=0.0.0.0
RFD4_PORT=8000
