# Optional explicit device (e.g. cuda, cuda:0, cpu). Defaults to CUDA if present.
# CHAI_DEVICE=cuda

# Directory to stage per-run FASTA inputs and CIF outputs. Defaults to a
# temporary directory under the system temp root.
# CHAI_SCRATCH_DIR=/scratch/chai

# Whether to use ESM embeddings (recommended) and the ColabFold MSA server.
CHAI_USE_ESM_EMBEDDINGS=true
CHAI_USE_MSA_SERVER=false

CHAI_HOST=0.0.0.0
CHAI_PORT=8000
