# Optional Hugging Face token for gated ESM-C weights.
ESMC_HF_TOKEN=

# Optional explicit device (e.g. cuda, cuda:0, cpu). Defaults to CUDA if present.
# ESMC_DEVICE=cuda

# Load a model during startup instead of on the first request.
# ESMC_PRELOAD_MODEL=esmc_600m

ESMC_HOST=0.0.0.0
ESMC_PORT=8000
