# Path to the boltz executable (default: resolved from PATH).
# BOLTZ_EXECUTABLE=boltz

# Weight/data cache directory (default: ~/.boltz).
# BOLTZ_CACHE_DIR=/scratch/boltz_cache

# Directory to stage per-run YAML inputs and prediction outputs.
# BOLTZ_SCRATCH_DIR=/scratch/boltz

# Number of devices boltz should use, and whether to use the mmseqs2 MSA server.
BOLTZ_DEVICES=1
BOLTZ_USE_MSA_SERVER=false

BOLTZ_HOST=0.0.0.0
BOLTZ_PORT=8000
